// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  expiresAt DateTime?
  sessionVersion Int @default(0)
  mustChangePassword Boolean @default(false)
  revision Int @default(1)
  aiAccessInitialized Boolean @default(false)
  aiModelGrants AiUserModelGrant[]
  aiConfiguration UserAiConfiguration?
  inviteUse InvitationUse?
  @@index([expiresAt])

  announcementReads AnnouncementRead[]
  conversations AiConversation[]
  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reviewSchedules ReviewSchedule[]
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  createdAt DateTime @default(now())
}

// Opaque encrypted configuration. Encryption key lives in persistent /app/config,
// not in the database or the portable export passphrase.
model AiConfiguration {
 id String @id
 revision Int @default(1)
 payload String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model AiJob {
 conversationId String?
 conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
 startedAt DateTime?
 id String @id @default(cuid())
 userId String
 kind String
 state String @default("pending")
 requestKey String
 input String
 result String?
 errorCode String?
 attempts Int @default(0)
 leaseOwner String?
 leaseUntil DateTime?
 cancelRequested Boolean @default(false)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 expiresAt DateTime
 attemptsLog AiAttempt[]
 @@unique([userId, requestKey])
 @@index([conversationId, createdAt])
 @@index([state, createdAt])
 @@index([userId, createdAt])
}

model AiAttempt {
 metadata String?
 id String @id @default(cuid())
 jobId String
 job AiJob @relation(fields:[jobId], references:[id], onDelete:Cascade)
 modelId String
 state String
 errorCode String?
 startedAt DateTime @default(now())
 finishedAt DateTime?
}

model AiWorkerLease {
 id String @id
 owner String
 until DateTime
}

model AiCooldown {
 id String @id
 until DateTime
}

// Content and human questions are encrypted in payload, never plain logs.
model AiConversation {
 id String @id @default(cuid())
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 state String @default("active")
 revision Int @default(0)
 roundsUsed Int @default(0)
 roundLimit Int @default(10)
 roundOpen Boolean @default(true)
 roundAttempts Int @default(0)
 attemptLimit Int @default(6)
 roundElapsedMs Int @default(0)
 timeLimitMs Int @default(600000)
 activeJobId String?
 payload String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 jobs AiJob[]
 actions AiConversationAction[]
 @@index([userId, updatedAt])
}
model AiConversationAction {
 id String @id @default(cuid())
 conversationId String
 conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
 requestKey String
 payload String
 @@unique([conversationId, requestKey])
}
model AiDialogueSettings {
 id String @id
 defaultRounds Int @default(10)
 revision Int @default(0)
}

// Site-wide notices. No AI payloads or credentials belong here.
model Announcement {
 id String @id @default(cuid())
 titleZh String
 bodyZh String
 titleEn String @default("")
 bodyEn String @default("")
 href String @default("")
 status String @default("draft") // draft, published, hidden, archived
 pinned Boolean @default(false)
 pinOrder Int @default(0)
 readPolicy String @default("keep") // keep -> history; hide -> personal only; persistent -> inbox
 startsAt DateTime?
 endsAt DateTime?
 revision Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 reads AnnouncementRead[]
 @@index([status, pinned, pinOrder, createdAt])
}
model AnnouncementRead {
 announcementId String
 userId String
 readAt DateTime @default(now())
 announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 @@id([announcementId, userId])
 @@index([userId, readAt])
}

model RegistrationSettings {
 id String @id
 enabled Boolean @default(false)
 inviteRequired Boolean @default(false)
 defaultExpirationDays Int? @default(7)
 inviteDefaultLifetimeDays Int @default(30)
 inviteDisplayEnabled Boolean @default(false)
 displayedInviteId String?
 revision Int @default(1)
 updatedAt DateTime @updatedAt
}
model InvitationCode {
 id String @id @default(cuid())
 codeHash String @unique
 encryptedCode String
 maxUses Int @default(1)
 usedCount Int @default(0)
 expiresAt DateTime
 enabled Boolean @default(true)
 revision Int @default(1)
 createdById String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 uses InvitationUse[]
 @@index([expiresAt, enabled])
}
model InvitationUse {
 userId String @id
 inviteId String
 user User @relation(fields:[userId], references:[id], onDelete:Cascade)
 invite InvitationCode @relation(fields:[inviteId], references:[id], onDelete:Restrict)
 createdAt DateTime @default(now())
}
model AuthRateLimit {
 key String @id
 count Int @default(0)
 windowEnd DateTime
 @@index([windowEnd])
}
model UserAuditEvent {
 id String @id @default(cuid())
 actorId String?
 targetId String?
 action String
 createdAt DateTime @default(now())
}
model AiAccessPolicy {
 id String @id
 revision Int @default(1)
 initialized Boolean @default(false)
}
model AiSiteModelAccess {
 modelId String @id
 fingerprint String
 isAllowed Boolean @default(true)
 defaultRank Int?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 grants AiUserModelGrant[]
}
model AiUserModelGrant {
 userId String
 modelId String
 source String
 rank Int?
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 siteModel AiSiteModelAccess @relation(fields:[modelId],references:[modelId],onDelete:Restrict)
 @@id([userId,modelId])
}
model UserAiConfiguration {
 userId String @id
 revision Int @default(1)
 payload String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
