# 数据库连接地址
# 本地开发通常使用 SQLite，路径相对于 prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth 会话加密密钥
# 新安装必须生成强随机值；升级时保留原值。本项目统一保留NEXTAUTH_SECRET；AUTH_SECRET为框架别名，无需另外配置。
# 可以使用 `openssl rand -base64 32` 生成；不要把输出提交到Git。
NEXTAUTH_SECRET=""

# 应用唯一的主站URL，不支持多个地址或逗号分隔。其他公网域名应在边缘/反代跳转到此地址。
# 本地开发通常是 http://localhost:3000
# Zeabur/Docker生产环境必须设置为实际HTTPS站点地址，用于登录回调与同源校验
# NEXTAUTH_URL="http://localhost:3000"

# 信任 Host 请求头
# 保留旧部署兼容项；不能代替生产环境显式的NEXTAUTH_URL，也不用于AI接口同源判定
AUTH_TRUST_HOST=true

# AI 服务提供商配置
# 可选值: "gemini" (默认) 或 "openai"
AI_PROVIDER="gemini"

# OpenAI 配置 (当 AI_PROVIDER="openai" 时需要)
OPENAI_API_KEY=""
OPENAI_BASE_URL="" # 可选，用于兼容的 API 服务
OPENAI_MODEL="gpt-4o" # 可选，默认为 gpt-4o

# Google Gemini 配置 (当 AI_PROVIDER="gemini" 时需要)
GOOGLE_API_KEY=""
GEMINI_BASE_URL="" # 可选，用于自定义 API 地址
GEMINI_MODEL="gemini-2.5-flash" # 可选，默认为 gemini-2.5-flash

# 日志配置
# 日志级别: trace, debug, info, warn, error, fatal
# 开发环境建议使用 debug，生产环境建议使用 info
LOG_LEVEL="info"

# Database Debugging
# Set to "true" to enable SQL query logging
DEBUG_DB="false"

# Openclaw Agent API 配置
# 用于对接本地部署的 Openclaw agent 进行错题识别
OPENCLAW_API_URL="http://localhost:8080"  # Openclaw agent 服务地址
OPENCLAW_API_KEY=""  # Openclaw API 密钥
OPENCLAW_TIMEOUT=30000  # 请求超时时间（毫秒），默认30秒

# 兼容说明：新用户系统不再将以下旧认证项作为独立登录入口。
# Openclaw批量上传必须使用有效站点登录会话，只能写当前账号。
# 本系统旧版 API 认证模式配置
# 可选值: "credentials" (用户名密码登录，默认) 或 "apikey" (API Key认证)
OPENCLAW_AUTH_MODE="credentials"

# 本系统 API 密钥（用于 Openclaw agent 调用本系统）
# 仅当 OPENCLAW_AUTH_MODE=apikey 时需要配置
# 生成方式: openssl rand -hex 32
OPENCLAW_INTEGRATION_API_KEY=""

# 新安装且无管理员时必需；自行填写至少12字符的独立口令，不提交真实值。
INITIAL_ADMIN_EMAIL="admin@localhost"
INITIAL_ADMIN_PASSWORD=""

# AI配置主钥：通常自动保存config/ai-master.key，无需设置此环境变量。
# 如设置，必须为32字节的base64或64位十六进制；与数据库一起安全备份。
# AI_CONFIG_MASTER_KEY=""
# AI_CONFIG_DIR="./config"
# AI_WORKER_DISABLED=1 # 仅构建/离线测试用，生产不能启用

# 本地运行且必须通过可信回环HTTP代理时显式启用；云端默认不要设置。
# 仅接受http://127.0.0.1:端口或http://[::1]:端口，无账号/路径/查询。
# AI目标仍须公共HTTPS；通过固定公共DoH解析并固定CONNECT目标，不放行Fake-IP。
# AI_LOCAL_HTTPS_PROXY="http://127.0.0.1:7890"

# 登录与注册均强制Turnstile；缺配置或校验失败时拒绝登录。
# 升级前先在Cloudflare创建站点，并填入实际值。Secret只存服务端，绝不提交。
SOLVNOTE_TURNSTILE_SITE_KEY=""
SOLVNOTE_TURNSTILE_SECRET_KEY=""
# 可选：精确hostname，逗号分隔，无协议/端口/通配符；缺省从NEXTAUTH_URL提取。
# SOLVNOTE_TURNSTILE_HOSTNAMES="solvnote.example.com"
# 此白名单只校验Turnstile令牌，不扩展应用同源策略；填多个域名不等于支持多站点登录/写入。

# 默认所有角色都不能导出AI配置。仅运维显式置true时恢复管理员加密导出。
# 不属于UI设置项；普通用户仍无站点配置导出权限。导入/编辑/空模板不受影响。
SOLVNOTE_ENABLE_AI_CONFIG_EXPORT=false

# 仅在源站不可绕过可信反代、且反代会覆盖客户端IP头时才置true。
# 默认不信CF-Connecting-IP/X-Forwarded-For，仅按账号限流并强制Turnstile。
# 缺少可信IP时不使用全站共享限流桶，避免攻击者耗尽桶而锁住所有用户。
SOLVNOTE_TRUST_PROXY_HEADERS=false
